# ============================================================
# Shadow — Environment Configuration
# Copy to .env and fill in your values BEFORE running.
# NEVER commit .env to version control.
# ============================================================

# Database
DATABASE_URL=sqlite:///./shadow.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/shadow

# SECURITY: Generate a strong random key (min 32 chars).
# Run: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Changing this invalidates all existing sessions.
SECRET_KEY=CHANGE_ME_generate_with_secrets.token_hex_32

# ── AI Backend Seçimi ────────────────────────────────────────────────────────
# AI_BACKEND: auto | local | anthropic | mock
#   auto      → Ollama varsa local kullan, yoksa Anthropic, ikisi de yoksa mock
#   local     → Sadece Ollama (API anahtarı gerekmez)
#   anthropic → Sadece Anthropic bulut API
#   mock      → AI yok, dummy veri (test/geliştirme)
AI_BACKEND=auto

# Ollama (local model) ayarları
# Kurulum: https://ollama.com — tek komut: curl -fsSL https://ollama.com/install.sh | sh
OLLAMA_BASE_URL=http://localhost:11434
# Vision modeli (görsel analiz için):
#   moondream   ~1.7GB RAM  — en hızlı
#   llava-phi3  ~2.9GB RAM  — iyi denge
#   llava:7b    ~4.1GB RAM  — yüksek kalite
OLLAMA_VISION_MODEL=moondream
# Metin modeli (AI arama için):
#   gemma2:2b    ~1.6GB RAM
#   llama3.2:3b  ~2.0GB RAM  — önerilen
#   mistral:7b   ~4.1GB RAM
OLLAMA_TEXT_MODEL=llama3.2:3b

# Anthropic Claude API key (AI_BACKEND=anthropic veya auto fallback için)
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# File upload directory (absolute path recommended in production)
UPLOAD_DIR=./uploads

# Allowed CORS origins (comma-separated, no trailing slash)
# In production: set this to your actual frontend URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
